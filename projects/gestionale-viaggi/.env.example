# ─────────────────────────────────────────────────────────────────────────────
# Configurazione di Gestionale Viaggi
# Copiare in .env.local e compilare. Il file .env.local non va mai committato.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase ----------------------------------------------------------------
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Chiave di servizio: scavalca la Row Level Security.
# Serve solo lato server (inviti, operazioni di sistema). Non esporla mai al browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Applicazione -------------------------------------------------------------
# Usato nei link delle email transazionali (magic link, inviti, recupero password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Usato solo da script e test (migrazioni, generazione tipi, test RLS).
# In produzione: Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Email transazionali (fase 8) ---------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_MITTENTE="Orizzonti Viaggi <no-reply@orizzontiviaggi.it>"

# --- Test end-to-end ----------------------------------------------------------
# Percorso di un Chromium già installato (utile in container e CI).
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome
# Indirizzo di un'applicazione già avviata: se assente, Playwright avvia `npm run dev`.
# E2E_BASE_URL=http://localhost:3000
